# ==============================================================================
# S.A.R.A — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo como ".env" en esta misma carpeta y completa tus claves.

# --- Servidor Backend (Node.js / Express) ---
PORT=3000
NODE_ENV=development

# --- Inteligencia Artificial (Gemini - Obligatoria para conversación de SARA) ---
GEMINI_API_KEY=

# --- Google Cloud / YouTube Data API v3 (Obligatoria para el módulo de música) ---
GOOGLE_CLOUD_API_KEY=

# --- OpenAI Whisper API (Opcional: solo para endpoint /api/whisper-stt en Node.js) ---
OPENAI_API_KEY=
